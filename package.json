{
  "name": "pm-workbench",
  "version": "1.0.2",
  "description": "Personal spin-off of dotpm for Obsidian: Markdown project management with Table, Gantt, Kanban, CPM, Baseline, Dependencies & Workload.",
  "repository": "github:MFaveri/obsidian-pm-mod",
  "type": "module",
  "main": "main.js",
  "imports": {
    "#main": "./src/main.ts",
    "#store": "./src/store/index.ts",
    "#store/*": "./src/store/*.ts",
    "#ui/*": "./src/ui/*.ts",
    "#modals/*": "./src/modals/*.ts",
    "#test/*": "./test/*.ts"
  },
  "scripts": {
    "dev": "run-p dev:js dev:css",
    "dev:js": "pnpm build:viewer && tsdown --watch",
    "dev:css": "node scripts/build-styles.mjs --watch",
    "build": "run-p build:js build:css",
    "build:js": "pnpm build:viewer && node -e \"import('node:child_process').then((c)=>c.execFileSync('pnpm',['exec','tsdown'],{stdio:'inherit',shell:process.platform==='win32',env:{...process.env,PRODUCTION:'1'}}))\"",
    "build:css": "node scripts/build-styles.mjs --production",
    "check": "run-p check:**",
    "check:code": "oxlint ./src ./packages ./test",
    "check:format": "oxfmt --check ./src ./packages ./test",
    "check:submission": "eslint --max-warnings 0 src/ packages/",
    "check:types": "tsc -noEmit -skipLibCheck",
    "fix": "run-p fix:**",
    "fix:code": "oxlint --fix ./src ./packages ./test",
    "fix:format": "oxfmt ./src ./packages ./test",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build:viewer": "node scripts/build-viewer.mjs",
    "build:packages": "pnpm --filter @dotpm/core --filter @dotpm/api --filter @dotpm/viewer build"
  },
  "devDependencies": {
    "@2bad/axiom": "2.1.0",
    "@2bad/tsconfig": "4.0.0",
    "@arethetypeswrong/cli": "0.18.5",
    "@dotpm/api": "workspace:*",
    "@dotpm/core": "workspace:*",
    "@dotpm/ui": "workspace:*",
    "@types/node": "26.6.5",
    "@typescript-eslint/parser": "8.71.1",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.12.0",
    "eslint-plugin-obsidianmd": "0.4.2",
    "happy-dom": "20.14.6",
    "lightningcss": "1.33.0",
    "monkey-around": "3.0.0",
    "npm-run-all2": "9.0.3",
    "obsidian": "1.13.1",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "publint": "0.3.25",
    "tsdown": "0.23.0",
    "typescript": "6.0.3",
    "vitest": "5.0.3",
    "yaml": "2.9.1"
  },
  "engines": {
    "node": ">=24"
  },
  "volta": {
    "node": "24.15.0",
    "pnpm": "11.5.3"
  },
  "packageManager": "pnpm@11.5.3"
}
